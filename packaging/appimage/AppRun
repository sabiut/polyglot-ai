#!/bin/bash
# AppRun — entry point for the Polyglot AI AppImage
APPDIR="$(dirname "$(readlink -f "$0")")"
export APPDIR

# The bundled interpreter is a relocatable standalone CPython (see
# build_appimage.sh): it finds its own stdlib and site-packages from its
# location, so nothing needs exporting. The old launcher exported
# PYTHONHOME / PYTHONPATH / LD_LIBRARY_PATH / PATH for a venv layout that
# couldn't start anyway — and every child process inherited them, so
# `python3` in the built-in terminal, git hooks and test runs all picked
# up the AppImage's Python. Clear any Python variables from the user's
# environment too: -s skips the user site-packages, -E ignores PYTHON*.
unset PYTHONHOME PYTHONPATH

# Self-register a launcher entry on first run so the AppImage
# shows up in the user's app menu without requiring appimaged or
# AppImageLauncher. Idempotent — re-running just rewrites the
# same files. We do this in shell (instead of leaving it to the
# Python startup path) so the icon appears in the menu before the
# Python interpreter even imports its first PyQt module.
#
# Exec= is rewritten to the AppImage's actual path on disk, taken
# from $APPIMAGE (set by appimagetool's runtime). Without that,
# launching from the menu would try ``polyglot-ai`` on PATH —
# almost certainly absent on a freshly-downloaded AppImage.
if [ -n "$APPIMAGE" ] && [ -f "$APPIMAGE" ]; then
    USER_APPS="$HOME/.local/share/applications"
    USER_ICONS="$HOME/.local/share/icons/hicolor"
    # Marker so we don't re-run the slow ``update-desktop-database``
    # + ``gtk-update-icon-cache`` calls on every launch — they
    # spawn subprocesses and add 200-500ms of cold-start delay on
    # HDD-backed laptops. First launch (or after the AppImage
    # binary changes) writes the marker; subsequent launches skip
    # everything in this branch.
    MARKER="$HOME/.local/share/polyglot-ai/.appimage-registered"
    MARKER_FOR="$(cat "$MARKER" 2>/dev/null)"
    if [ "$MARKER_FOR" != "$APPIMAGE" ]; then
        mkdir -p "$USER_APPS"
        if [ -f "$APPDIR/polyglot-ai.desktop" ]; then
            sed "s|Exec=polyglot-ai|Exec=$APPIMAGE|" \
                "$APPDIR/polyglot-ai.desktop" > "$USER_APPS/polyglot-ai.desktop"
        fi
        for sz in 16 32 48 128 256 512; do
            src="$APPDIR/usr/share/icons/hicolor/${sz}x${sz}/apps/polyglot-ai.png"
            if [ -f "$src" ]; then
                mkdir -p "$USER_ICONS/${sz}x${sz}/apps"
                cp -f "$src" "$USER_ICONS/${sz}x${sz}/apps/polyglot-ai.png"
            fi
        done
        svg="$APPDIR/usr/share/icons/hicolor/scalable/apps/polyglot-ai.svg"
        if [ -f "$svg" ]; then
            mkdir -p "$USER_ICONS/scalable/apps"
            cp -f "$svg" "$USER_ICONS/scalable/apps/polyglot-ai.svg"
        fi
        command -v update-desktop-database >/dev/null 2>&1 && \
            update-desktop-database -q "$USER_APPS" >/dev/null 2>&1 || true
        command -v gtk-update-icon-cache >/dev/null 2>&1 && \
            gtk-update-icon-cache -f -t "$USER_ICONS" >/dev/null 2>&1 || true
        # Record which AppImage path we registered for — if the
        # user moves or replaces the AppImage, the path no longer
        # matches and we re-register on the next launch.
        mkdir -p "$(dirname "$MARKER")"
        printf '%s\n' "$APPIMAGE" > "$MARKER"
    fi
fi

# ``-m polyglot_ai`` (the package's __main__), not ``-m polyglot_ai.app``:
# app.py has no __main__ guard, so the old line imported it and exited
# silently — another reason the AppImage never opened a window.
exec "$APPDIR/usr/bin/python3" -s -E -m polyglot_ai "$@"
