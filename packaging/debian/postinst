#!/bin/bash
set -e

INSTALL_DIR="/opt/polyglot-ai"
VENV_DIR="$INSTALL_DIR/venv"
WHEELS_DIR="$INSTALL_DIR/wheels"
PINS="$INSTALL_DIR/constraints.txt"

# Create virtual environment
python3 -m venv "$VENV_DIR"

# Three attempts, most trustworthy first:
#   1. offline, from the bundled wheels, at the tested versions — works
#      behind a corporate proxy, on a fresh install, on a flight.
#      ``--no-index`` forbids contacting PyPI; ``--find-links`` makes
#      the resolver use the bundle; the constraints are the versions
#      the test suite ran against;
#   2. online for whatever the bundle lacks for this Python, still at
#      the tested versions (wheels only, so no compiler is needed);
#   3. online with whatever versions resolve — for a Python the pins
#      have no wheels for yet. A bundle problem can never leave the
#      package unusable, but it is said out loud which path was taken.
echo "Installing Polyglot AI from bundled wheels (offline)…"
if "$VENV_DIR/bin/pip" install --no-index --find-links "$WHEELS_DIR" \
        --constraint "$PINS" "$INSTALL_DIR"/*.whl; then
    echo "Installed from the bundled wheels (offline, tested versions)."
elif echo "Bundle incomplete for this Python; fetching the rest from PyPI…" && \
     "$VENV_DIR/bin/pip" install --find-links "$WHEELS_DIR" --only-binary :all: \
        --constraint "$PINS" "$INSTALL_DIR"/*.whl; then
    echo "Installed with the tested versions (part of it from PyPI)."
else
    echo "Tested versions unavailable for this Python; installing the newest compatible ones…"
    "$VENV_DIR/bin/pip" install --upgrade pip
    "$VENV_DIR/bin/pip" install --find-links "$WHEELS_DIR" "$INSTALL_DIR"/*.whl
    echo "Installed from PyPI with the newest compatible versions (not the tested set)."
fi

# Create symlink
ln -sf "$VENV_DIR/bin/polyglot-ai" /usr/local/bin/polyglot-ai

# Refresh desktop and icon caches so the launcher entry and icon
# appear in the user's app menu immediately, not after the next
# login. dpkg triggers usually handle this on Debian/Ubuntu, but
# being explicit is belt-and-braces — it matters on minimal
# installs (Docker images, chroots, server distros) where the
# triggering path might not be wired up. Both tools no-op when
# the optional package providing them isn't installed.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    # ``-f`` forces a refresh even when mtime didn't change;
    # ``-t`` prevents a hard fail if the index file is missing.
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
fi

# Hint that Arduino uploads need the user to be in the dialout
# group. Resolve the target user via a small fallback chain
# because graphical software-centres (gnome-software, KDE
# Discover) run dpkg via polkit and leave ``$SUDO_USER`` empty —
# the hint would silently never appear and the user would later
# hit "Permission denied on /dev/ttyUSB0" with no context.
#
# Resolution order:
#   1. ``$SUDO_USER`` (terminal-style ``sudo apt install ./…``)
#   2. ``$PKEXEC_UID`` (polkit-mediated installs)
#   3. ``logname`` (active TTY's login user)
#   4. First non-system user from ``/etc/passwd`` (UID >= 1000)
TARGET_USER="${SUDO_USER:-}"
if [ -z "$TARGET_USER" ] && [ -n "${PKEXEC_UID:-}" ]; then
    TARGET_USER="$(getent passwd "$PKEXEC_UID" 2>/dev/null | cut -d: -f1)"
fi
if [ -z "$TARGET_USER" ]; then
    TARGET_USER="$(logname 2>/dev/null || true)"
fi
if [ -z "$TARGET_USER" ]; then
    TARGET_USER="$(awk -F: '$3 >= 1000 && $3 < 65000 {print $1; exit}' /etc/passwd 2>/dev/null || true)"
fi

if [ -n "$TARGET_USER" ] && ! id -nG "$TARGET_USER" 2>/dev/null | grep -qw dialout; then
    echo ""
    echo "Heads up: to use the Arduino upload feature you'll need"
    echo "to be in the 'dialout' group. Run:"
    echo "    sudo usermod -aG dialout $TARGET_USER"
    echo "and log out / back in."
fi

echo "Polyglot AI installed successfully."
echo "Run 'polyglot-ai' to start, or find it in your application menu."
